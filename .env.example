# Copy this file to .env.local and fill in the values

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Google OAuth (with YouTube scopes)
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# YouTube channel to track
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# YouTube Data API v3 key (server-side, for admin channel search)
# Create at https://console.cloud.google.com → APIs & Services → Credentials → API Key
# Restrict it to YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key

# Database (SQLite by default, change for production)
DATABASE_URL="file:./dev.db"

# Google site verification (get token from Google Search Console → HTML tag method)
GOOGLE_SITE_VERIFICATION=your-verification-token

# iOS app — Sign in with Apple (developer.apple.com → Keys → Sign in with Apple key)
# Used to verify identity tokens and to revoke Apple tokens on account deletion.
APPLE_BUNDLE_ID=com.fiveguysfc.cards
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
