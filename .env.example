# Copy this file to .env.local and fill in the values

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl-rand-base64-32

# Google OAuth (with YouTube scopes)
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# YouTube channel to track
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# YouTube Data API v3 key (server-side, for admin channel search)
# Create at https://console.cloud.google.com → APIs & Services → Credentials → API Key
# Restrict it to YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-api-key

# Database (SQLite by default, change for production)
DATABASE_URL="file:./dev.db"

# Google site verification (get token from Google Search Console → HTML tag method)
GOOGLE_SITE_VERIFICATION=your-verification-token

# iOS app — Sign in with Apple (developer.apple.com → Keys → Sign in with Apple key)
# Used to verify identity tokens and to revoke Apple tokens on account deletion.
APPLE_BUNDLE_ID=com.fiveguysfc.cards
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Website — Sign in with Apple (lib/apple-web.ts). A Services ID grouped with the app's App ID,
# return URL https://www.5iveg.com/api/sign-in/apple/callback. Unset = no Apple button on the website.
APPLE_SERVICES_ID=

# Email sign-in with a 6-digit code (lib/email-sign-in.ts), website and app. Uses RESEND_API_KEY below
# and a sender on a domain verified in Resend. Unset = no email option.
EMAIL_FROM=                 # e.g. "5iveG <hello@5iveg.com>"

# Player consent form (/consent) — emails each signed form via Resend (free account at resend.com)
RESEND_API_KEY=
CONSENT_EMAIL_TO=           # where signed forms go: the Resend account's own email until a domain is verified
CONSENT_EMAIL_FROM=         # optional, a sender on a domain verified in Resend (default onboarding@resend.dev)

# Printed card shop (/shop) — Stripe Checkout
STRIPE_SECRET_KEY=          # sk_live_… in Production, sk_test_… in Preview/Development
STRIPE_WEBHOOK_SECRET=      # optional, for /api/store/webhook (checkout.session.completed)
CRON_SECRET=                # Vercel cron auth: /api/cron/shop-sync records any missed orders
SHOP_EMAIL_TO=              # optional, new-order emails (default CONSENT_EMAIL_TO)
